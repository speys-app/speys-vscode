{
  "name": "tools",
  "displayName": "Speys Tools",
  "description": "Repo switcher, Claude sessions and pinned shortcuts in one list for multi-root workspaces, add files to Claude Code, open HTML and PDF files in your browser.",
  "publisher": "speys",
  "version": "0.6.0",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/speys-app/speys-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/speys-app/speys-vscode/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "repo switcher",
    "multi-root",
    "workspace",
    "source control",
    "claude"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce package --no-dependencies --out speys-tools.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "speysTools.pick",
        "title": "%command.pick%",
        "category": "Speys Tools",
        "icon": "$(repo)"
      },
      {
        "command": "speysTools.sessions",
        "title": "%command.sessions%",
        "category": "Speys Tools",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "speysTools.tab",
        "title": "%command.tab%",
        "category": "Speys Tools"
      },
      {
        "command": "speysTools.nextClaudeSession",
        "title": "%command.nextClaudeSession%",
        "category": "Speys Tools"
      },
      {
        "command": "speysTools.nextSession",
        "title": "%command.nextSession%",
        "category": "Speys Tools"
      },
      {
        "command": "speysTools.addToClaude",
        "title": "%command.addToClaude%",
        "category": "Speys Tools",
        "icon": "$(mention)"
      },
      {
        "command": "speysTools.openInBrowser",
        "title": "%command.openInBrowser%",
        "category": "Speys Tools",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "speysTools.addToClaude",
          "when": "!explorerResourceIsFolder",
          "group": "claude@1"
        },
        {
          "command": "speysTools.openInBrowser",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(html?|pdf)$/i",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "speysTools.addToClaude",
          "when": "editorIsOpen"
        },
        {
          "command": "speysTools.openInBrowser",
          "when": "resourceExtname =~ /^\\.(html?|pdf)$/i"
        },
        {
          "command": "speysTools.tab",
          "when": "false"
        },
        {
          "command": "speysTools.nextSession",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "speysTools.openInBrowser",
          "when": "resourceExtname =~ /^\\.(html?|pdf)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Speys Tools",
      "properties": {
        "speysTools.addRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.addRoot%"
        },
        "speysTools.browser": {
          "type": "string",
          "default": "Google Chrome",
          "markdownDescription": "%config.browser%"
        },
        "speysTools.claudeCodeCss": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.claudeCodeCss%"
        },
        "speysTools.shortcuts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array"
              }
            },
            "required": [
              "label",
              "command"
            ]
          },
          "default": [
            {
              "label": "Reload Window",
              "command": "workbench.action.reloadWindow"
            },
            {
              "label": "Toggle Terminal",
              "command": "workbench.action.terminal.toggleTerminal"
            },
            {
              "label": "Open Settings",
              "command": "workbench.action.openSettings"
            }
          ],
          "markdownDescription": "%config.shortcuts%"
        },
        "speysTools.sessionLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "default": "sidebar",
          "markdownDescription": "%config.sessionLocation%"
        }
      }
    },
    "keybindings": [
      {
        "command": "speysTools.pick",
        "mac": "cmd+e",
        "key": "ctrl+alt+e",
        "when": "(activeWebviewPanelId != 'claudeVSCodePanel' || panelFocus) && (!claude-vscode.sideBarActive || !auxiliaryBarFocus) && focusedView != 'claudeVSCodeSidebar'"
      },
      {
        "command": "speysTools.tab",
        "args": 1,
        "mac": "cmd+1",
        "key": "ctrl+alt+1"
      },
      {
        "command": "speysTools.tab",
        "args": 2,
        "mac": "cmd+2",
        "key": "ctrl+alt+2"
      },
      {
        "command": "speysTools.tab",
        "args": 3,
        "mac": "cmd+3",
        "key": "ctrl+alt+3"
      },
      {
        "command": "speysTools.nextSession",
        "args": 1,
        "key": "tab",
        "when": "inQuickOpen && speysTools.sessionsTab"
      },
      {
        "command": "speysTools.nextSession",
        "args": -1,
        "key": "shift+tab",
        "when": "inQuickOpen && speysTools.sessionsTab"
      },
      {
        "command": "speysTools.nextClaudeSession",
        "mac": "cmd+e",
        "key": "ctrl+alt+e",
        "when": "(activeWebviewPanelId == 'claudeVSCodePanel' && !panelFocus) || (claude-vscode.sideBarActive && auxiliaryBarFocus) || focusedView == 'claudeVSCodeSidebar'"
      }
    ]
  }
}
